# Copy to .env for Docker Compose. This file contains no credentials.
ATELIER_BIND_ADDRESS=127.0.0.1
ATELIER_PORT=3000
ATELIER_IMAGE=ghcr.io/kirito718/infinite-atelier
IMAGE_TAG=latest
PULL_POLICY=build
CODEX_CLI_VERSION=0.153.4

# User accounts and persistent storage. /data is the atelier-data named volume.
# REQUIRED when accessing through an HTTPS reverse proxy: match the browser origin.
# Include scheme and non-default port, but no page path or container-internal URL.
# An unset/mismatched origin causes login/signup to report "不允许跨站修改数据".
# HTTPS origins enable Secure cookies automatically.
# ATELIER_PUBLIC_URL=https://atelier.example.com
# After editing this root .env, recreate the existing service to apply changes:
# docker compose up -d --no-deps --force-recreate --no-build --pull never atelier
# Verify: docker compose exec -T atelier printenv ATELIER_PUBLIC_URL
# docker compose restart alone does not apply changed environment variables.
ATELIER_ALLOW_REGISTRATION=false
ATELIER_SECURE_COOKIES=false
ATELIER_ALLOW_PRIVATE_UPSTREAMS=false
ATELIER_MAX_UPLOAD_BYTES=104857600
ATELIER_USER_QUOTA_BYTES=2147483648
# encryption.key is generated in /data; back it up together with the database.

# Private server-side ComfyUI endpoint; never use VITE_ for these variables.
# With the gpu profile: http://comfyui:8188
# Mac Docker -> native ComfyUI: http://host.docker.internal:8188
# Native development: http://127.0.0.1:8188
COMFYUI_BASE_URL=http://comfyui:8188
COMFYUI_API_PREFIX=/api
COMFYUI_WS_ENABLED=true
COMFYUI_TASK_TTL_MS=3600000
COMFYUI_REQUEST_TIMEOUT_MS=120000
COMFYUI_MAX_BYTES=26214400
COMFYUI_REF=a99d1f9c14f4594fe1e9d7e17c1997bf104d89fb

# Optional native/server override; directory must contain portrait-pose-depth-api.json
# COMFYUI_WORKFLOW_DIR=/opt/atelier-workflows
