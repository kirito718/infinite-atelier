# Server-only variables. Copy to web/.env for Node, or root .env for Compose.
# Never use a VITE_ prefix for credentials or server storage settings.
# Default is web/data for Node and /data (named volume) in Compose.
# ATELIER_DATA_DIR=/var/lib/infinite-atelier

# Required for remote HTTPS reverse-proxy deployment: exact public origin.
# ATELIER_PUBLIC_URL=https://atelier.example.com
# HTTPS PUBLIC_URL automatically enables Secure cookies; don't enable on HTTP localhost.
ATELIER_SECURE_COOKIES=false

# First account can always register. Open temporarily for additional trusted users.
ATELIER_ALLOW_REGISTRATION=false

# Default denies loopback/private/link-local upstream targets, including redirects.
# Enable ONLY for trusted users who need an internal model service.
ATELIER_ALLOW_PRIVATE_UPSTREAMS=false

# 100 MiB per file; 2 GiB of media per account. Document limit: 20 MiB each / 128 MiB total encrypted.
ATELIER_MAX_UPLOAD_BYTES=104857600
ATELIER_USER_QUOTA_BYTES=2147483648

# Optional 32-byte AES key encoded as 64 hex characters.
# If omitted, encryption.key is generated in ATELIER_DATA_DIR. Back it up with the database.
# NEVER replace or rotate this independently of the encrypted database.
# ATELIER_ENCRYPTION_KEY=
